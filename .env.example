# Comma-separated list of VK access tokens (service tokens recommended).
# Each token gets its own rate-limit bucket (3 req/s). Use multiple to parallelize.
VK_TOKENS=

VK_API_VERSION=5.199

POSTGRES_USER=vkstat
POSTGRES_PASSWORD=vkstat
POSTGRES_DB=vkstat
POSTGRES_PORT=5432

REDIS_PORT=6379
API_PORT=8000
